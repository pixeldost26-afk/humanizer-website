# ==============================================================================
# HumanizeAI Environment Variables
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="humanizeai-super-secure-nextauth-secret-key-32-chars-minimum"

# Google OAuth 2.0 (Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI:
# Local: http://localhost:3000/api/auth/callback/google
# Production: https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Database Connection (Prisma)
# By default in local development, SQLite is supported out of the box (file:./dev.db)
# For production PostgreSQL (Supabase, Neon, RDS), use:
# DATABASE_URL="postgresql://username:password@localhost:5432/humanizeai?schema=public"
DATABASE_URL="file:./dev.db"

# AI Provider Configuration
# Options: "openai" | "demo"
# When left empty or "demo", HumanizeAI operates in safe high-fidelity Demo Mode.
AI_PROVIDER="demo"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# Stripe Subscriptions & Billing (International)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY="price_pro_monthly_test"
STRIPE_PRICE_PRO_ANNUAL="price_pro_annual_test"
STRIPE_PRICE_BUSINESS_MONTHLY="price_business_monthly_test"
STRIPE_PRICE_BUSINESS_ANNUAL="price_business_annual_test"

# Razorpay Architecture (India)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Administrator Configuration
ADMIN_EMAIL="admin@humanizeai.com"
